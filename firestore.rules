
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check for existing relationship
    function isAuthorizedViewer(userId) {
      return request.auth.uid in get(/databases/$(database)/documents/users/$(userId)).data.authorizedViewers;
    }

    match /users/{userId} {
      // READ: Allow a user to read their own profile, or the profile of someone they have transacted with.
      allow read: if request.auth.uid == userId || isAuthorizedViewer(userId);
      
      // WRITE (Create, Update): Only the user themselves can write to their own profile.
      allow write: if request.auth.uid == userId;
    }

    match /transactions/{transactionId} {
      // READ: Only the customer or the shopkeeper involved in the transaction can read it.
      allow read: if request.auth.uid == resource.data.customerId || request.auth.uid == resource.data.shopId;
      
      // CREATE: A logged-in user can create a transaction only if they are the customer.
      allow create: if request.auth != null && request.auth.uid == request.resource.data.customerId;
      
      // UPDATE: Only the customer can update their transactions (e.g., to settle them).
      allow update: if request.auth.uid == resource.data.customerId;
      
      // DELETE: Nobody can delete transactions.
      allow delete: if false;
    }
  }
}
