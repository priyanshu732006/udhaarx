
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // A function to check if the requesting user and the target user
    // are linked via any transaction. This is the key to solving the
    // permission issue securely. It checks both directions (customer-to-shop
    // and shop-to-customer).
    function areLinkedByTransaction(requestingUid, targetUid) {
      // Check if there's a transaction where requester is customer and target is shop
      let customerToShopQuery = query.collection('transactions')
                                     .where('customerId', '==', requestingUid)
                                     .where('shopId', '==', targetUid)
                                     .limit(1);
      // Check if there's a transaction where requester is shop and target is customer
      let shopToCustomerQuery = query.collection('transactions')
                                     .where('shopId', '==', requestingUid)
                                     .where('customerId', '==', targetUid)
                                     .limit(1);

      return firestore.get(customerToShopQuery).size > 0 || firestore.get(shopToCustomerQuery).size > 0;
    }

    // USERS collection
    // Users can manage their own profile.
    // They can read another user's profile ONLY IF they are linked by a transaction.
    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || areLinkedByTransaction(request.auth.uid, userId));
      allow create, update, delete: if request.auth != null && request.auth.uid == userId;
    }

    // TRANSACTIONS collection
    // A user can create a transaction only if they are the customer.
    // They can read a transaction if they are either the customer or the shop.
    // They can only update the 'settled' field, and only if they are the customer.
    match /transactions/{transactionId} {
      allow read: if request.auth != null && (resource.data.customerId == request.auth.uid || resource.data.shopId == request.auth.uid);
      allow create: if request.auth != null && request.data.customerId == request.auth.uid;
      allow update: if request.auth != null &&
                       request.data.settled == true &&
                       resource.data.settled == false &&
                       resource.data.customerId == request.auth.uid &&
                       request.data.diff(resource.data).affectedKeys().hasOnly(['settled']);
    }
  }
}
