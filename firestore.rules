rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Function to check if a transaction exists between two users
    function transactionExists(userId1, userId2) {
      return exists(/databases/$(database)/documents/transactions?where("customerId", "in", [userId1, userId2])&where("shopId", "in", [userId1, userId2]));
    }

    // Users can read/write their own data.
    // They can also read another user's data if a transaction links them.
    match /users/{userId} {
      allow read: if request.auth.uid == userId || transactionExists(request.auth.uid, userId);
      allow write: if request.auth.uid == userId;
    }

    // A user can only create transactions for themselves.
    // A user can only read transactions where they are either the customer or the shopkeeper.
    // A customer can update transactions to mark them as settled.
    match /transactions/{transactionId} {
      allow read: if request.auth.uid == resource.data.customerId || request.auth.uid == resource.data.shopId;
      allow create: if request.auth.uid == request.resource.data.customerId;
      allow update: if request.auth.uid == resource.data.customerId && request.resource.data.settled == true;
    }
  }
}
