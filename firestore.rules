
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
  
    function isSignedIn() {
      return request.auth != null;
    }

    // A user can read another user's profile if a transaction exists between them
    function isLinked(otherUserId) {
        return exists(/databases/$(database)/documents/transactions/{transactionId})
            where 
                (resource.data.customerId == request.auth.uid && resource.data.shopId == otherUserId) ||
                (resource.data.shopId == request.auth.uid && resource.data.customerId == otherUserId);
    }
    
    // Users can read/write their own profile
    // Or can read another user's profile if they are linked by a transaction
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isLinked(userId));
      allow create, update: if isSignedIn() && request.auth.uid == userId;
    }

    // Transactions can be read by the customer or the shopkeeper.
    // They can be created by the customer.
    // They can be settled (updated) by the customer.
    match /transactions/{transactionId} {
      allow read: if isSignedIn() && (request.auth.uid == resource.data.customerId || request.auth.uid == resource.data.shopId);
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.customerId;
      // Allow a customer to update a transaction only to mark it as settled.
      allow update: if isSignedIn() && 
                      request.auth.uid == resource.data.customerId &&
                      request.resource.data.settled == true &&
                      resource.data.settled == false;
    }
  }
}
