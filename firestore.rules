
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if a user is the owner of a document
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // Helper function to check for an existing transaction between two users
    function transactionExists(userId1, userId2) {
      return exists(/databases/$(database)/documents/transactions/{transactionId})
             && (
                  (resource.data.customerId == userId1 && resource.data.shopId == userId2) ||
                  (resource.data.customerId == userId2 && resource.data.shopId == userId1)
                );
    }
    
    match /users/{userId} {
      // A user can read/write their own profile
      allow read, write: if isOwner(userId);

      // A user can read another user's profile IF a transaction exists between them
      // This is needed for customers to get the shopkeeper's upiId
      allow get: if request.auth != null && transactionExists(request.auth.uid, userId);
    }

    match /transactions/{transactionId} {
      // Anyone logged in can read a transaction IF they are the customer or the shopkeeper for it
      allow get: if request.auth != null && (isOwner(resource.data.customerId) || isOwner(resource.data.shopId));
      
      // A customer can create a transaction for themselves
      allow create: if request.auth != null && isOwner(request.resource.data.customerId);

      // A customer can update a transaction to mark it as settled
      allow update: if request.auth != null 
                    && isOwner(request.resource.data.customerId)
                    && request.resource.data.settled == true
                    && resource.data.settled == false;

      // No one can delete transactions
      allow delete: if false;
    }
  }
}
