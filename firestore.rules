
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // A user can read another user's profile if their UID is in the other user's 'authorizedViewers' list.
    // They can always read their own profile.
    // They can only write to their own profile.
    match /users/{userId} {
      allow read: if request.auth.uid == userId || (request.auth.uid in resource.data.authorizedViewers);
      allow write: if request.auth.uid == userId;
    }

    // Transactions can be read by the customer or the shopkeeper.
    // Transactions can only be created by the customer themselves.
    // Transactions can only be updated (to be marked as settled) by the customer.
    match /transactions/{transactionId} {
      allow read: if request.auth.uid == resource.data.customerId || request.auth.uid == resource.data.shopId;
      allow create: if request.auth.uid == request.resource.data.customerId;
      allow update: if request.auth.uid == resource.data.customerId && request.resource.data.settled == true;
      allow delete: if false;
    }
  }
}
