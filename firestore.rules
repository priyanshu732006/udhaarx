
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check for existing transactions
    function hasTransactedWith(userId1, userId2) {
      return exists(/databases/$(database)/documents/users/$(userId1)) &&
             userId2 in get(/databases/$(database)/documents/users/$(userId1)).data.authorizedViewers;
    }

    // Rules for the 'users' collection
    match /users/{userId} {
      // Allow a user to read their own profile.
      // Allow a user to read another user's profile if they have transacted with them.
      allow read: if request.auth.uid == userId ||
                     (request.auth != null && hasTransactedWith(userId, request.auth.uid));

      // Allow a user to create or update ONLY their own profile.
      allow write: if request.auth.uid == userId;
    }

    // Rules for the 'transactions' collection
    match /transactions/{transactionId} {
      // Allow a user to create a transaction ONLY IF they are the customer.
      allow create: if request.auth.uid == request.resource.data.customerId;

      // Allow read access to a transaction for the customer or the shopkeeper involved.
      allow read: if request.auth.uid == resource.data.customerId ||
                     request.auth.uid == resource.data.shopId;
      
      // Allow the customer to update a transaction to mark it as settled.
      // Protect other fields from being changed.
      allow update: if request.auth.uid == resource.data.customerId &&
                       request.resource.data.settled == true &&
                       resource.data.settled == false; // Can only change from unsettled to settled

      // Do not allow transactions to be deleted.
      allow delete: if false;
    }
  }
}
