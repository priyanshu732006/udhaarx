
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
  
    // Users can only read their own profile, or profiles of users they have transacted with.
    // Users can only create their own profile and can only update their own profile.
    match /users/{userId} {
      allow read: if request.auth != null && 
                  (request.auth.uid == userId || request.auth.uid in get(/databases/$(database)/documents/users/$(userId)).data.authorizedViewers);
      allow create, update: if request.auth != null && request.auth.uid == userId;
    }

    // A user can create a transaction if they are the customer making the transaction.
    // A customer can read their own transactions.
    // A shopkeeper can read transactions associated with their shop.
    // Transactions can only be marked as settled (updated) by the customer who created them.
    match /transactions/{transactionId} {
      allow create: if request.auth != null && request.auth.uid == request.resource.data.customerId;
      
      allow read: if request.auth != null && 
                  (request.auth.uid == resource.data.customerId || request.auth.uid == resource.data.shopId);

      allow update: if request.auth != null && 
                     request.auth.uid == resource.data.customerId &&
                     request.resource.data.settled == true &&
                     resource.data.settled == false; // Prevent re-opening a settled transaction
    }
  }
}
