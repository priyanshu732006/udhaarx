rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
  
    // Helper function to check if the requesting user has transacted with the target user.
    function userIsAuthorized(targetUserId) {
      // Check if the current user's UID is in the target user's 'authorizedViewers' list.
      return request.auth.uid in get(/databases/$(database)/documents/users/$(targetUserId)).data.authorizedViewers;
    }
    
    // Rules for the 'users' collection (customer and shopkeeper profiles)
    match /users/{userId} {
      // Allow a user to read their own profile.
      // Also allow a user to read another user's profile IF they are in that user's 'authorizedViewers' list.
      allow read: if request.auth.uid == userId || (request.auth != null && userIsAuthorized(userId));

      // Allow a user to create or update their own profile only.
      // Using 'write' instead of separate 'create' and 'update' for simplicity.
      allow write: if request.auth.uid == userId;
    }

    // Rules for the 'transactions' collection
    match /transactions/{transactionId} {
      // A user can read a transaction if they are either the customer or the shopkeeper involved.
      allow read: if request.auth != null && (request.auth.uid == resource.data.customerId || request.auth.uid == resource.data.shopId);

      // A customer can create a new transaction.
      allow create: if request.auth != null && request.auth.uid == request.resource.data.customerId;
      
      // A customer can update a transaction to mark it as 'settled'.
      // This rule ensures only the 'settled' field can be changed by the customer.
      allow update: if request.auth != null 
                    && request.auth.uid == resource.data.customerId
                    && request.resource.data.settled == true
                    && resource.data.settled == false; // Prevent re-settling
    }
  }
}
