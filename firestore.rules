
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users can read their own profile, and any authenticated user can read any other user profile.
    // This is simplified to ensure the app can fetch shopkeeper UPI IDs.
    // In a production app with sensitive user data, this should be more restrictive.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // A user can read/write a transaction if they are either the customer or the shopkeeper.
    match /transactions/{transactionId} {
      allow read, write: if request.auth != null && 
        (
          (exists(path(resource.data.customerId)) && resource.data.customerId == request.auth.uid) || 
          (exists(path(resource.data.shopId)) && resource.data.shopId == request.auth.uid)
        );
      
      allow create: if request.auth != null && request.resource.data.customerId == request.auth.uid;
    }
  }
}
