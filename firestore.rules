
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
  
    // Users can only read their own profile, or the profile of someone they have transacted with.
    // Users can only write to their own profile.
    match /users/{userId} {
      allow read: if request.auth.uid == userId 
                    || (request.auth != null && resource.data.authorizedViewers.hasAny([request.auth.uid]));
      allow write: if request.auth.uid == userId;
    }

    // Transactions can be created by the customer.
    // They can be read by either the customer or the shopkeeper involved.
    // They can be updated (e.g., to settle) by the customer.
    match /transactions/{transactionId} {
      allow read: if request.auth.uid == resource.data.customerId || request.auth.uid == resource.data.shopId;
      allow create: if request.auth.uid == request.resource.data.customerId;
      allow update: if request.auth.uid == resource.data.customerId;
      allow delete: if false;
    }
  }
}
