rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Users can create their own profile and update it.
    // A user can read another user's profile ONLY IF they are linked by a transaction.
    // This is crucial for customers to read a shopkeeper's upiId to make a payment.
    match /users/{userId} {
      allow read: if request.auth != null && (
        request.auth.uid == userId ||
        exists(/databases/$(database)/documents/transactions_by_user/{request.auth.uid}/shops/{userId})
      );
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Transactions can be created by the customer.
    // They can be read by either the customer or the shopkeeper involved.
    // A transaction can only be updated (e.g., to set `settled: true`) by the customer.
    match /transactions/{transactionId} {
      allow create: if request.auth != null && request.resource.data.customerId == request.auth.uid;
      allow read: if request.auth != null && (
        resource.data.customerId == request.auth.uid ||
        resource.data.shopId == request.auth.uid
      );
      allow update: if request.auth != null &&
        resource.data.customerId == request.auth.uid &&
        request.resource.data.settled == true;
      allow delete: if false; // Transactions should not be deletable
    }

    // This is a helper collection to efficiently check for the existence of a relationship
    // between a customer and a shopkeeper without needing to query the entire transactions collection.
    // This document is created/updated via a Cloud Function (or similar backend logic) when a transaction is made.
    // Since we cannot create cloud functions here, this rule is prepared for that structure.
    // For now, the user read rule is simplified to not depend on this.
    // A better rule would be:
    // exists(/databases/$(database)/documents/transactions_by_user/$(request.auth.uid)/shops/$(userId))
    // To make this work without functions, we can do a less efficient query in the rules.
    // Let's use a function for a more robust check.
    function userIsLinked(otherUserId) {
        return exists(
            /databases/$(database)/documents/transactions?where("customerId", "==", request.auth.uid).where("shopId", "==", otherUserId)
        ) || exists(
            /databases/$(database)/documents/transactions?where("shopId", "==", request.auth.uid).where("customerId", "==", otherUserId)
        );
    }
  }
}
