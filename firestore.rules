rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Users can only write to their own profile.
    // Any authenticated user can read any other user's profile.
    // This is necessary to get profile info like names and UPI IDs.
    // Security is maintained by queries in the app code, which only
    // fetch transactions for the logged-in user.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Transactions collection
    match /transactions/{transactionId} {
      // A user can create a transaction if they are the customer.
      allow create: if request.auth != null && request.resource.data.customerId == request.auth.uid;

      // A user can read a transaction if they are the customer OR the shopkeeper.
      allow read: if request.auth != null && 
                  (resource.data.customerId == request.auth.uid || resource.data.shopId == request.auth.uid);
      
      // A user can update a transaction (to settle it) if they are the customer
      // and only changing the 'settled' field.
      allow update: if request.auth != null &&
                   resource.data.customerId == request.auth.uid &&
                   request.resource.data.keys().hasOnly(['settled']);
    }
  }
}
