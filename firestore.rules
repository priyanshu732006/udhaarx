rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Allow authenticated users to read any user's profile.
    // This is necessary for a customer to fetch a shopkeeper's UPI ID.
    // In a production app, this might be restricted further.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Transactions can only be read or written by users involved in them.
    match /transactions/{transactionId} {
      allow read, write: if request.auth != null && (resource.data.customerId == request.auth.uid || resource.data.shopId == request.auth.uid);
    }
  }
}
