
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if a customer has any transaction with a specific shop
    function hasTransactionWithShop(customerId, shopId) {
      // Check if there is at least one transaction document where the
      // customerId and shopId match the provided arguments.
      // We check for both unsettled and settled transactions to allow customers
      // to see their payment history and for the shop to see all customers.
      return exists(/databases/$(database)/documents/transactions) &&
             firestore.get(
               /databases/$(database)/documents/transactions
             ).where('customerId', '==', customerId)
              .where('shopId', '==', shopId)
              .limit(1)
              .get()
              .size() > 0;
    }

    match /users/{userId} {
      // A user can always create, read, or write their own profile document.
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Additionally, allow a user (customer) to read a shopkeeper's profile
      // if they have a transaction history with that shopkeeper.
      // This is crucial for fetching the shopkeeper's UPI ID for payments.
      allow get: if request.auth != null && hasTransactionWithShop(request.auth.uid, userId);
    }

    match /transactions/{transactionId} {
      // A user can create a transaction only if they are the customer in that transaction.
      allow create: if request.auth != null && request.resource.data.customerId == request.auth.uid;

      // A user can read a transaction if they are either the customer or the shopkeeper.
      allow get, list: if request.auth != null && 
                          (get(/databases/$(database)/documents/transactions/$(transactionId)).data.customerId == request.auth.uid ||
                           get(/databases/$(database)/documents/transactions/$(transactionId)).data.shopId == request.auth.uid);
                           
      // A customer can update a transaction only to mark it as settled.
      // They cannot change any other field.
      allow update: if request.auth != null && 
                       request.resource.data.customerId == request.auth.uid &&
                       request.resource.data.settled == true &&
                       resource.data.settled == false &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['settled']);
    }
  }
}
