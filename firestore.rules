rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Users can read/write their own profiles.
    // A user can also read another user's profile if they are a customer
    // in any transaction with that user (who is the shop).
    match /users/{userId} {
      allow read: if request.auth.uid == userId ||
                   (request.auth != null && exists(/databases/$(database)/documents/transactions/{transactionId}) &&
                    get(/databases/$(database)/documents/transactions/{transactionId}).data.customerId == request.auth.uid &&
                    get(/databases/$(database)/documents/transactions/{transactionId}).data.shopId == userId);
      allow write: if request.auth.uid == userId;
    }

    // Transactions can be created by the customer.
    // They can be read by either the customer or the shopkeeper.
    // They can only be updated (settled) by the customer.
    match /transactions/{transactionId} {
      allow create: if request.auth.uid == request.resource.data.customerId;
      allow read: if request.auth.uid == resource.data.customerId || request.auth.uid == resource.data.shopId;
      allow update: if request.auth.uid == resource.data.customerId && request.resource.data.settled == true;
      allow delete: if false; // Transactions should not be deletable
    }
  }
}
