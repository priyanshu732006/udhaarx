rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow users to read and write their own profile
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Rules for transactions
    match /transactions/{transactionId} {
      // Allow any authenticated user to create a transaction
      allow create: if request.auth != null;

      // Allow users to read transactions if they are the customer or the shopkeeper
      allow read: if request.auth != null && (request.auth.uid == resource.data.customerId || request.auth.uid == resource.data.shopId);
    }
  }
}
