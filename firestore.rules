
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // User profiles (customers and shopkeepers)
    // Allow any authenticated user to read any profile (needed for customer to get shopkeeper's UPI ID).
    // Only allow a user to write to their own profile.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth.uid == userId;
    }

    // Transactions
    // Allow a user to read/write a transaction only if they are the customer or the shopkeeper in that transaction.
    match /transactions/{transactionId} {
      allow read, create, update: if request.auth != null && 
        (request.resource.data.customerId == request.auth.uid || request.resource.data.shopId == request.auth.uid ||
         (resource != null && (resource.data.customerId == request.auth.uid || resource.data.shopId == request.auth.uid)));
    }
  }
}
